# Solana RPC endpoint (devnet). Public default works; a paid RPC is more reliable for demos.
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com

# Public base URL of this app. Used inside NFT metadata so the artwork URL resolves.
# Local: http://localhost:3400   Production: https://your-deployment.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3400
